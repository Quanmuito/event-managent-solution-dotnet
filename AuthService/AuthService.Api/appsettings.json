{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MongoDb": {
    "ConnectionString": "mongodb://mongo:27017",
    "DatabaseName": "events-management-solution"
  },
  "Jwt": {
    "Secret": "replace-with-at-least-32-characters-secret-key",
    "Issuer": "AuthService",
    "Audience": "EmsClients",
    "ExpiryMinutes": 60
  },
  "AllowedHosts": "*"
}
